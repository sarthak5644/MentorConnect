# ==========================================================
# MentorConnect Backend - Environment Variables
# Copy this file to .env and fill in real values before running.
# ==========================================================

# ---------------- App ----------------
APP_NAME=MentorConnect
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# ---------------- Database (MySQL) ----------------
DB_HOST=db
DB_PORT=3306
DB_USER=mentorconnect_user
DB_PASSWORD=change_this_password
DB_NAME=mentorconnect_db
DB_ROOT_PASSWORD=change_this_root_password
# SQLAlchemy pool tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# ---------------- JWT Auth ----------------
JWT_SECRET_KEY=replace_with_a_long_random_secret_key_min_64_chars
JWT_REFRESH_SECRET_KEY=replace_with_a_different_long_random_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------- Password / Security ----------------
BCRYPT_ROUNDS=12
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
CSRF_SECRET_KEY=replace_with_another_long_random_secret_key

# ---------------- OTP ----------------
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ---------------- Captcha ----------------
CAPTCHA_LENGTH=6
CAPTCHA_EXPIRE_MINUTES=5
CAPTCHA_WIDTH=220
CAPTCHA_HEIGHT=90

# ---------------- Email (SMTP) ----------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=no-reply@mentorconnect.com
SMTP_FROM_NAME=MentorConnect
SMTP_USE_TLS=true

# ---------------- SMS (Mobile OTP Provider) ----------------
# Generic provider config - swap implementation in services/sms_service.py
SMS_PROVIDER=console   # console | twilio
SMS_API_KEY=your_sms_provider_api_key
SMS_API_SECRET=your_sms_provider_api_secret
SMS_SENDER_ID=MENTORC
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---------------- File Upload ----------------
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_EXTENSIONS=["jpg","jpeg","png","webp"]
ALLOWED_DOCUMENT_EXTENSIONS=["pdf","jpg","jpeg","png"]

# ---------------- Rate Limiting ----------------
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_OTP=3/minute

# ---------------- Logging ----------------
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_RETENTION_DAYS=30

# ---------------- Super Admin Bootstrap ----------------
SUPERADMIN_EMAIL=admin@mentorconnect.com
SUPERADMIN_PASSWORD=ChangeMe@123
SUPERADMIN_FULL_NAME=Super Admin
